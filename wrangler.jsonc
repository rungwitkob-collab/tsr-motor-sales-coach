{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ชื่อ Worker = ส่วนหน้าของ URL -> https://coach.<workers.dev subdomain ของบัญชี>.workers.dev
  // บัญชีปัจจุบันมี subdomain "fpc-tool" อยู่แล้ว URL จริงคือ https://coach.fpc-tool.workers.dev
  "name": "coach",
  "main": "src/worker/index.ts",
  // วันที่ล่าสุดที่ workerd ใน wrangler เวอร์ชันที่ติดตั้งรองรับ (ถ้าใช้ 2026-10-31 คำสั่ง npm run dev จะเปิดไม่ขึ้น)
  // อัปเดตได้ภายหลังเมื่ออัปเกรด wrangler: npm i -D wrangler@latest แล้วเปลี่ยนเป็นวันที่ปัจจุบัน
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  // Static Assets: หน้าเว็บ React ที่ build แล้ว (Vite plugin จะชี้ไปที่ dist/client ให้อัตโนมัติ)
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // ให้ /api/* วิ่งเข้า Worker ก่อนเสมอ ส่วนไฟล์อื่นเสิร์ฟจาก assets โดยไม่เสีย CPU ของ Worker
    "run_worker_first": ["/api/*"]
  },
  // ค่าที่ไม่ใช่ความลับ (secret จริงตั้งด้วย `npx wrangler secret put ...`)
  "vars": {
    // รุ่นเริ่มต้นสำหรับแชท/ประเมิน (ผู้ใช้แต่ละเครื่องสลับได้จากเมนู "ตั้งค่า" ตามรายการใน src/shared/models.ts)
    // ตัวเลือกที่รองรับ: gemini-3.5-flash-lite (ประหยัดโควตา), gemini-3.5-flash, gemini-3.8-flash, gemini-2.5-flash
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // รุ่น TTS สำหรับเสียงลูกค้า (รองรับภาษาไทย) ผู้ใช้เลือกได้ในเมนู "ตั้งค่า" ว่าจะใช้เสียง Gemini หรือเสียงของเครื่อง
    // ใส่ "off" เพื่อบังคับปิดเสียง AI ทั้งระบบ (ทุกเครื่องจะใช้เสียงของเบราว์เซอร์)
    "GEMINI_TTS_MODEL": "gemini-3.8-flash-tts",
    "RATE_LIMIT_PER_MINUTE": "20"
  },
  "observability": {
    "enabled": true
  }
  // (อนาคต) ถ้าต้องการเก็บสถิติบน Cloudflare KV ให้เพิ่ม:
  // "kv_namespaces": [{ "binding": "PROGRESS_KV", "id": "<id จาก npx wrangler kv namespace create PROGRESS_KV>" }]
}
